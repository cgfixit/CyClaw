# CyClaw Apple Silicon / MLX tunings for `ollama serve`.
# Repo-managed. No secrets. Source BEFORE starting Ollama — the running
# .app will NOT pick these up until it is fully quit and relaunched.
#
#   set -a
#   . macos/ollama-mlx.env
#   set +a
#   ollama serve
#
# Or copy into the Ollama.app LaunchAgent if you start it that way.
# Weight quant is the Ollama tag (see OLLAMA_SETUP.md), not an env var.

# RAG path floor: max_context_tokens (16000) + local_llm.max_tokens (4096)
# + ~1500 = 21,596 <= 32768. 32768 is the shipped RAG window on 48 GB.
# KV q8_0 + flash attention below keep the doubled KV cache affordable on
# 48 GB unified memory. OLLAMA_NUM_PARALLEL=1 stays mandatory because
# parallel slots multiply KV RAM by context length.
OLLAMA_CONTEXT_LENGTH=32768

# 27B cold-load is expensive. Keep the weights resident between /query turns
# and harness /loop iterations. "0" unloads immediately (bad for this model).
OLLAMA_KEEP_ALIVE=30m

# 48 GB unified cannot host three 18–32 GB models plus CyClaw's Python process.
OLLAMA_MAX_LOADED_MODELS=1

# Metal decode is memory-bandwidth bound. Parallel slots multiply KV RAM
# (NUM_PARALLEL * CONTEXT_LENGTH) and stall both /query and /loop.
OLLAMA_NUM_PARALLEL=1

# llama.cpp-runner knobs. Ollama enables Flash Attention automatically when
# the backend supports it; force-on is documented. KV q8_0 halves cache RAM
# vs f16 with small quality loss — useful at 32k ctx on 48 GB. If the loaded
# tag is MLX-native (qwen3.8:27b-mlx / nvfp4 / mxfp8) these two MAY be no-ops;
# they still help if you fall back to the generic qwen3.8:27b GGUF tag.
# q4_0 is more aggressive; measure quality before using it on RAG answers.
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
