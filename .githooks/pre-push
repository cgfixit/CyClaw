#!/usr/bin/env bash
# Enforce documented multi-vendor branch naming and fresh-main ancestry on push.
# Canonical feature prefixes: utils.agent_identity.ALLOWED_BRANCH_PREFIXES
# (CLAUDE.md §5, Kimi section, .github/PULL_REQUEST_TEMPLATE.md).

## Note: Critical pr description requirement:
# -Always fill out and utilize this template: .github/PULL_REQUEST_TEMPLATE.md fully when opening a PR

set -euo pipefail

allowed_branch() {
  case "$1" in
    main|master|develop) return 0 ;;
    grok/*|claude/*|codex/*|kimi/*|agent/*|CyClaw/*|cyclaw/*) return 0 ;;
    dependabot/*|renovate/*) return 0 ;;
    release/*|hotfix/*) return 0 ;;
    *) return 1 ;;
  esac
}

requires_fresh_main() {
  case "$1" in
    main|master|develop) return 1 ;;
    *) return 0 ;;
  esac
}

remote_name="${1:-origin}"

local_refs=()
local_shas=()
remote_refs=()
remote_shas=()

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -n "$local_ref" ]] || continue
  local_refs+=("$local_ref")
  local_shas+=("$local_sha")
  remote_refs+=("$remote_ref")
  remote_shas+=("$remote_sha")
done

if ! git fetch origin main --prune; then
  printf '%s\n' \
    'pre-push: refused push because origin/main could not be refreshed.' \
    '  Restore network/authentication and re-run: git fetch origin main --prune' \
    >&2
  exit 1
fi

fail=0
for i in "${!local_refs[@]}"; do
  local_ref="${local_refs[$i]}"
  local_sha="${local_shas[$i]}"
  remote_ref="${remote_refs[$i]}"
  # skip branch deletes
  if [[ "$local_sha" =~ ^0+$ ]]; then
    continue
  fi
  if [[ "$remote_ref" == refs/heads/* ]]; then
    branch="${remote_ref#refs/heads/}"
    if ! allowed_branch "$branch"; then
      printf '%s\n' \
        "pre-push: refused push of branch '${branch}'" \
        "  Feature branches must use a documented vendor prefix:" \
        "  grok/ | claude/ | codex/ | kimi/ | agent/ | CyClaw/ | cyclaw/" \
        "  Also allowed: main | master | develop | dependabot/* | renovate/* |" \
        "                 release/* | hotfix/*" \
        "  Rename:  git branch -m <prefix>/<feature> && git push -u origin HEAD" \
        >&2
      fail=1
    fi

    if requires_fresh_main "$branch" && ! git merge-base --is-ancestor origin/main "$local_sha"; then
      printf '%s\n' \
        "pre-push: refused push of stale branch '${branch}'" \
        '  Rebase on fresh main, inspect conflicts, and rerun affected checks:' \
        '  git fetch origin main --prune' \
        '  git rebase origin/main' \
        '  <run validation>' \
        '  git push' \
        '  Use --force-with-lease only with explicit approval after a prior push.' \
        >&2
      fail=1
    fi
  fi
done

# Security gate: protected-branch and non-fast-forward pushes, plus a secret
# and blocked-file scan of every commit this push would publish (catches
# commits made with --no-verify or from a clone without hooks). See
# .githooks/_security.sh and security.conf.
# shellcheck source=SCRIPTDIR/_security.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_security.sh"
for i in "${!local_refs[@]}"; do
  sec_pre_push_ref "$remote_name" "${local_refs[$i]}" "${local_shas[$i]}" \
    "${remote_refs[$i]}" "${remote_shas[$i]}" || fail=1
done
sec_pre_push_finish || fail=1

exit "$fail"
