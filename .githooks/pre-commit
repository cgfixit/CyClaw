#!/usr/bin/env bash
# Block commits on branches outside the documented multi-vendor allowlist.
# This case list is the canonical feature-prefix allowlist; .githooks/pre-push
# mirrors it (+ PR template / CLAUDE.md §10 / Kimi section document it).

## Note: Critical pr description requirement:
# -Always fill out and utilize this template: .github/PULL_REQUEST_TEMPLATE.md fully when opening a PR
set -euo pipefail

branch="$(git symbolic-ref --short HEAD 2>/dev/null || true)"
# Detached HEAD (rebase, bisect, etc.) — skip the naming check only
if [[ -n "$branch" ]]; then
  case "$branch" in
    main|master|develop) ;;
    # Vendor / agent feature prefixes (keep in step with pre-push allowed_branch)
    grok/*|claude/*|codex/*|kimi/*|agent/*|CyClaw/*|cyclaw/*) ;;
    dependabot/*|renovate/*) ;;
    release/*|hotfix/*) ;;
    *)
      printf '%s\n' \
        "pre-commit: branch '${branch}' violates naming convention" \
        "  Feature branches must use a documented vendor prefix:" \
        "  grok/ | claude/ | codex/ | kimi/ | agent/ | CyClaw/ | cyclaw/" \
        "  Also allowed: main | master | develop | dependabot/* | renovate/* |" \
        "                 release/* | hotfix/*" \
        "  Rename:  git branch -m <prefix>/<feature>" \
        >&2
      exit 1
      ;;
  esac
fi

# Security gate: secrets by content and filename, protected control files,
# ruff F,B,S on staged Python. See .githooks/_security.sh and security.conf.
# shellcheck source=SCRIPTDIR/_security.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_security.sh"
sec_pre_commit || exit 1
